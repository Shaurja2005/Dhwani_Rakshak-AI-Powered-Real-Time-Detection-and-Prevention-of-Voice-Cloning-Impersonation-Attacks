# Head A (distilled student) on NVIDIA Triton — B14-T04.
# The ONNX file is produced by `python -m ml.export.to_onnx` into 1/model.onnx
# and must pass `python -m ml.export.parity_check` before it is placed here.
name: "head_a"
backend: "onnxruntime"
max_batch_size: 32

input [
  {
    name: "wav"               # 16 kHz mono float32; 3 s windows = 48000 samples
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]
output [
  {
    name: "spoof_logit"       # p_spoof = sigmoid(spoof_logit); calibration is baked in
    data_type: TYPE_FP32
    dims: [ ]
  },
  {
    name: "raw_score"         # cosine to the bona fide centre (higher = more bona fide)
    data_type: TYPE_FP32
    dims: [ ]
  }
]

# Windows from many concurrent calls are batched together. The queue delay is
# kept far below the 1 s window hop; requests that cannot be served in time are
# rejected (the gateway then abstains with reason=timeout, invariant I10) rather
# than queued behind live audio.
dynamic_batching {
  preferred_batch_size: [ 8, 16, 32 ]
  max_queue_delay_microseconds: 20000
  default_queue_policy {
    timeout_action: REJECT
    default_timeout_microseconds: 300000
    allow_timeout_override: true
    max_queue_size: 256
  }
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator: [
      { name: "tensorrt"
        parameters { key: "precision_mode" value: "FP16" }
        parameters { key: "max_workspace_size_bytes" value: "1073741824" } }
    ]
  }
}

version_policy: { latest { num_versions: 1 } }
