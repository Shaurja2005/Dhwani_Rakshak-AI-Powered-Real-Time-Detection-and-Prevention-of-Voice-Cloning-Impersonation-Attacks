# Copy to deploy/.env and fill in. deploy/.env is git-ignored and excluded from images.
# Generate 32-byte keys with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

VG_VERSION=local
VG_GATEWAY_BIND=127.0.0.1           # set to the LAN interface of the node for agents' browsers

VG_BOOTSTRAP_TENANT=demo
VG_BOOTSTRAP_KEY=                   # long random API key for the first admin (rotate after setup)

VG_KEK_B64=                         # key-encryption key (from the bank's KMS/HSM in production)
VG_VAULT_KEY_DEMO=                  # per-tenant voiceprint vault key: VG_VAULT_KEY_<TENANT_ID>

GRAFANA_ADMIN_PASSWORD=
VG_RETENTION_TENANTS=demo           # comma-separated tenant ids for the daily retention job
VG_EGRESS_ALLOWLIST=                # e.g. hooks.bank.internal  (webhook hosts; default deny)
VG_REPLAY_DIR=./replay              # WAV files for `make prod-replay` (synthetic calls if empty)
