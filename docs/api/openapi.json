  "components": {
    "schemas": {
      "AudioIn": {
        "properties": {
          "payload_base64": {
            "type": "string",
            "title": "Payload Base64"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "pcm_s16le",
              "mulaw",
              "alaw"
            ],
            "title": "Encoding",
            "default": "pcm_s16le"
          },
          "sample_rate": {
            "type": "integer",
            "maximum": 48000.0,
            "minimum": 8000.0,
            "title": "Sample Rate",
            "default": 16000
          }
        },
        "type": "object",
        "required": [
          "payload_base64"
        ],
        "title": "AudioIn"
      },
      "CallMetadata": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "UUIDv7"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "direction": {
            "type": "string",
            "pattern": "^(inbound|outbound)$",
            "title": "Direction"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "caller_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caller Number"
          },
          "callee_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callee Number"
          },
          "claimed_identity_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claimed Identity Id",
            "description": "Keys the voiceprint lookup"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "codec_hint": {
            "type": "string",
            "pattern": "^(g711u|g711a|g729|amrnb|opus|evs|pcm|unknown)$",
            "title": "Codec Hint"
          },
          "source_sample_rate": {
            "type": "integer",
            "maximum": 96000.0,
            "minimum": 8000.0,
            "title": "Source Sample Rate"
          },
          "trunk_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trunk Id"
          },
          "source_asn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Asn"
          },
          "sip_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Sip Headers"
          },
          "language_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language Hint"
          },
          "consent_basis": {
            "$ref": "#/components/schemas/ConsentBasis"
          },
          "shadow_mode": {
            "type": "boolean",
            "title": "Shadow Mode",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "tenant_id",
          "direction",
          "started_at",
          "channel",
          "codec_hint",
          "source_sample_rate",
          "consent_basis"
        ],
        "title": "CallMetadata",
        "description": "One per session, emitted at session start.  SOURCE_OF_TRUTH \u00a74.1"
      },
      "Channel": {
        "type": "string",
        "enum": [
          "pstn",
          "voip",
          "webrtc",
          "mobile",
          "file"
        ],
        "title": "Channel"
      },
      "ConsentBasis": {
        "type": "string",
        "enum": [
          "legitimate_use",
          "explicit_consent",
          "none"
        ],
        "title": "ConsentBasis"
      },
      "FeedbackIn": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "true_positive",
              "false_positive",
              "unsure"
            ],
            "title": "Label"
          },
          "analyst": {
            "type": "string",
            "title": "Analyst"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "label",
          "analyst"
        ],
        "title": "FeedbackIn"
      },
      "FileIn": {
        "properties": {
          "call_metadata": {
            "$ref": "#/components/schemas/CallMetadata"
          },
          "audio_base64": {
            "type": "string",
            "title": "Audio Base64"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          }
        },
        "type": "object",
        "required": [
          "call_metadata",
          "audio_base64"
        ],
        "title": "FileIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
