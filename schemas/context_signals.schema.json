{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiceguard.dev/schemas/context_signals.schema.json",
  "title": "ContextSignals",
  "description": "Output of B10 context/intent enrichment. See SOURCE_OF_TRUTH.md §4.6",
  "type": "object",
  "properties": {
    "session_id":          { "type": "string", "format": "uuid" },
    "as_of_ms":            { "type": "integer", "minimum": 0 },
    "metadata_risk":       { "type": "number", "minimum": 0, "maximum": 1 },
    "transaction_risk":    { "type": "number", "minimum": 0, "maximum": 1 },
    "intent_risk":         { "type": "number", "minimum": 0, "maximum": 1 },
    "intent_labels":       {
      "type": "array",
      "items": { "type": "string", "enum": ["manufactured_urgency", "secrecy_demand", "authority_pressure", "unusual_channel", "callback_resistance", "unusual_beneficiary"] }
    },
    "transcript_snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": { "type": "integer" },
          "text":     { "type": "string" },
          "label":    { "type": "string" }
        },
        "required": ["start_ms", "text", "label"]
      }
    },
    "language_detected":   { "type": "string", "description": "BCP-47 tag" },
    "code_switched":       { "type": "boolean" }
  },
  "required": ["session_id", "as_of_ms", "metadata_risk", "transaction_risk", "intent_risk", "intent_labels", "transcript_snippets", "language_detected", "code_switched"],
  "additionalProperties": false
}
